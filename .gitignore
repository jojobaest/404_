# =========================
# Unity / Meta XR Git Ignore
# =========================

# OS metadata
.DS_Store
Thumbs.db

# User-specific settings
UserSettings/
*.user
*.userprefs

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Mm]emoryCaptures/
[Rr]ecordings/
[Bb]ackUpThisFolder_ButDontShipItWithYourGame/

# Auto-generated Unity project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.opendb

# Crash and error files
sysinfo.txt
*.stacktrace

# Unity meta / serialization artifacts
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.asset.meta

# Platform builds
*.apk
*.aab
*.app
*.exe
*.xcodeproj/
*.xcworkspace/
*.ipa
*.unitypackage

# Addressables
/[Aa]ssets/AddressableAssetsData/*
/[Aa]ssets/StreamingAssets/aa*/
addressables_content_state.bin

# JetBrains Rider & Visual Studio cache
.vs/
.idea/
*.DotSettings.user

# Gradle cache / Android Studio
.gradle/
*.gradle
local.properties

# Generated by Burst / Jobs / Shader cache
[Bb]urstCache/
[Bb]ee/
[Oo]bj/
*.rspycache/

# Meta XR SDK & Tools (don’t track downloaded packages)
Packages/com.meta.xr.*
Packages/com.meta.xr.sdk.core-*/package/
Packages/com.meta.xr.mrutilitykit-*/package/

# Plugin / Package cache
Library/PackageCache/
Packages/manifest-temp.json

# Unity Cloud Build / Collaborate / Plastic SCM
/[Uu]ser[Ss]ettings/
/[Oo]rganizationSettings/
/[Pp]roject[Ss]ettings/.collabignore
/[Pp]roject[Ss]ettings/.plastic/

# Logs
*.log
*.trace
*.diff

# Profiler / Analytics dumps
*.pdata
*.profiler
*.csv
*.xml
*.json
*.binary

# Build system leftovers
DerivedDataCache/
ExportedObj/
Temp/

# XR specific caches
/Assets/MetaXR/Generated/
*.oculus/
OculusBuildLog.txt

# Ignore test APKs
*.apk
*.aab

# Backups / Old versions
*.bak
*.old
*.orig

# =========================
# End of Unity Ignore List
